# Sirve para crear CONFIG_SI7021. CMake lo revisa para decidir si si7021.c se construye.
# Los comentarios aplican a la línea siguiente.
config SI7021
	bool "Adafruit Si7021 TH Sensor"
    # Solo delcarado si se indica en el DT de la aplicacion
	default y
    # El sensor solo se declara si el DT declara "adafruit,si7021"
	depends on DT_HAS_ADAFRUIT_SI7021_ENABLED
    # Patron habitual para indicar la depencia dle periferico.
	select I2C
	help
	  Adafruit Si7021 TH Sensor
